{
  "name": "pocket-approve",
  "version": "0.1.0",
  "description": "Phone and desktop approvals for OpenCode permission prompts",
  "license": "MIT",
  "author": "Pocket Approve contributors",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engida32/pocket-approve.git"
  },
  "bugs": {
    "url": "https://github.com/engida32/pocket-approve/issues"
  },
  "homepage": "https://github.com/engida32/pocket-approve#readme",
  "keywords": [
    "opencode",
    "approval",
    "notifications",
    "ntfy",
    "web-push",
    "security"
  ],
  "files": [
    "lib/",
    "public/",
    "scripts/",
    "server.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "setup": "node scripts/setup-v2.mjs",
    "phone": "node scripts/phone.mjs",
    "connect": "node scripts/ntfy.mjs",
    "disconnect": "node scripts/ntfy.mjs --disconnect",
    "ntfy": "node scripts/ntfy.mjs",
    "test": "node --test test/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pair": "node scripts/admin.mjs pair",
    "devices": "node scripts/admin.mjs devices",
    "revoke": "node scripts/admin.mjs revoke",
    "doctor": "node scripts/admin.mjs doctor"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "web-push": "3.6.7"
  }
}
